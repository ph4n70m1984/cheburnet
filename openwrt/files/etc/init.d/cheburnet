#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

PROG=/usr/bin/cheburnetd
CONF=/etc/config/cheburnet

cleanup_children() {
    # Корректно глушим запущенные ядра, чтобы освободить порты
    killall -15 sing-box xray 2>/dev/null
    sleep 1
    killall -9 sing-box xray 2>/dev/null
}

start_service() {
    config_load cheburnet
    local enabled
    config_get_bool enabled main enabled 0
    [ "$enabled" -eq 1 ] || return 0

    # Защита от конфликта портов перед стартом
    cleanup_children

    procd_open_instance "main"
    procd_set_param command "$PROG" "start"

    # Оптимизация сборщика мусора Go без ограничений mmap виртуальной памяти
    procd_set_param env GOMEMLIMIT=48MiB
    procd_set_param env GOGC=25
    procd_set_param env GODEBUG=madvdontneed=1

    procd_set_param respawn 3600 5 5
    procd_set_param file "$CONF"
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param user root
    
    # Лимиты дескрипторов для большого числа одновременных TCP/UDP соединений
    procd_set_param limits core="unlimited" nofile="65535 65535"
    procd_close_instance
}

stop_service() {
    cleanup_children
}

service_triggers() {
    # Перезапуск сервиса при изменении конфигурации uci
    procd_add_reload_trigger "cheburnet"
    # Отслеживание поднятия локальной сети
    procd_add_interface_trigger "interface.*.up" "lan" /etc/init.d/cheburnet restart
}

reload_service() {
    # Сначала пытаемся мягко обновить конфигурацию через REST API демона
    if ! ubus call network.interface dump >/dev/null 2>&1 || ! wget -q -O- --post-data="" http://127.0.0.1:8088/api/v1/reload >/dev/null 2>&1; then
        # Если демон не ответил по API — делаем полный рестарт
        restart
    fi
}